# Copy to .env (gitignored). Values are read from the environment first, then from this file.

# Meta Model API key (SAM 3.1, Muse Spark, Muse Voice Transcribe): https://dev.meta.ai
META_API_KEY=

# Tapo C200: the camera account from the Tapo app (camera -> Advanced settings -> Camera account)
TAPO_IP=192.168.1.50
TAPO_USER=
TAPO_PASS=
# Tapo app (cloud) login password: go2rtc needs it for two-way audio to the camera speaker
TAPO_CLOUD_PASS=

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=remy-verify

# Optional: Twilio WhatsApp sandbox instead (config.json alerts.channel = "twilio")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
